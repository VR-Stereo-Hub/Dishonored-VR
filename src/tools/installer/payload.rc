// tools/installer/payload.rc - the embedded payload, by file NAME only.
// rc.exe resolves these through its include path; CMakeLists.txt points that at
// build/installer-payload/<config>/ where the staging step put the bytes.
#include "payload_ids.h"
1 ICON "assets/ui/launcher/launcher.ico"

IDR_D3D9            RCDATA "d3d9.dll"
IDR_SHIM            RCDATA "dvr_steamvr32.dll"
IDR_OPENVR          RCDATA "openvr_api.dll"
IDR_INI             RCDATA "dishonored_vr.ini"
IDR_COLLECT_SUPPORT RCDATA "collect-support.ps1"
IDR_HOWTO           RCDATA "HOW-TO-USE.txt"
IDR_TROUBLESHOOTING RCDATA "TROUBLESHOOTING.md"
IDR_KNOWN_ISSUES    RCDATA "KNOWN_ISSUES.md"
IDR_RELEASE_NOTES   RCDATA "RELEASE_NOTES.md"

#ifdef DVR_SETUP_DLSS
IDR_DLSS_HOST        RCDATA "dvr_dlss_host64.exe"
IDR_DLSS_NGX         RCDATA "nvngx_dlss.dll"
IDR_FFX_LOADER       RCDATA "amd_fidelityfx_loader_dx12.dll"
IDR_FFX_UPSCALER     RCDATA "amd_fidelityfx_upscaler_dx12.dll"
IDR_DLSS_NGX_LICENSE RCDATA "NVIDIA-DLSS-LICENSE.txt"
IDR_FFX_LICENSE      RCDATA "AMD-FIDELITYFX-LICENSE.md"
IDR_DLSS_NOTICE      RCDATA "NOTICE.md"
#endif

IDR_CONTROLLER_GUIDE RCDATA "assets/ui/launcher/quest3-controls.png"

IDR_RESHADE_BRIDGE RCDATA "DishonoredVR_ReShade.addon32"
IDR_INSTALL_RESHADE RCDATA "install-reshade.ps1"
