; d3d9.dll proxy export table. The game imports these nine names from the DLL
; next to Dishonored.exe; they must be UNDECORATED (no _Name@N), which the
; MinGW build got from -Wl,--kill-at and MSVC gets from this file.
LIBRARY d3d9
EXPORTS
    Direct3DCreate9
    Direct3DCreate9Ex
    D3DPERF_BeginEvent
    D3DPERF_EndEvent
    D3DPERF_SetOptions
    D3DPERF_GetStatus
    D3DPERF_SetMarker
    D3DPERF_SetRegion
    D3DPERF_QueryRepeatFrame
