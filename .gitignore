# Build output
build/
dist/
out/
.vs/
.vscode/
CMakeUserPresets.json

# Logs and runtime artifacts
*.log
*.pdb
imgui.ini

# Binaries: only the vendored OpenVR loader is tracked
*.dll
!third_party/openvr_headers/bin/win32/openvr_api.dll

# Frame dumps, captures and crash dumps are game-derived content
*.bmp
*.png
*.dxbc
*.dmp
*.rdc
captures/
dumps/

# Decompiled UnrealScript / extracted assets - Bethesda/Arkane copyright, never commit
tools/uscript/*
!tools/uscript/README.md
*.u
*.upk
*.tfc
*.bik
# Local IK reference derived from the installed player's mesh
*.psk
*.pskx
dishonored_vr_arm_rig.bin

# Python bytecode from the tools
__pycache__/
*.pyc

# OS noise
Thumbs.db
desktop.ini

# Local-only reference mirror of the BioShock VR mods (never commit)
docs/bsvr-reference/

# NVIDIA NGX SDK (tools/fetch-ngx.ps1): NVIDIA license, never committed
third_party/ngx/
# AMD FidelityFX SDK (tools/fetch-ffx.ps1): MIT, fetched, never committed
third_party/ffx/

# Offline RE and model tools (docs/IDA_WORKFLOW.md, docs/MODEL_WORKFLOW.md). The tools are
# paid or third-party software and are referenced by path from the LOCAL tool file
# (%LOCALAPPDATA%\DishonoredVR\dev-tools.json), never copied in. Their databases and
# outputs are game-derived. Our own scripts (tools/ida/*.py, tools/blender/*.py) are tracked.
*.exe
*.jar
*.msi
*.zip
*.i64
*.idb
*.id0
*.id1
*.id2
*.nam
*.til
*.blend
*.blend1
*.psa
*.fbx
*.glb
*.gltf
*.obj
*.mtl
*.tga
*.dds
tools/ida/out/
tools/ida/bin/
dev-tools.json
